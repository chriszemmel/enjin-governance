# Environment for Enjin Governance.
#
# Copy to .env.local for development. On Vercel, set the same names under
# Settings -> Environment Variables. lib/env.ts is the source of truth, and
# docs/ENVIRONMENT.md explains every variable.
#
# Every variable is optional or has a default; an empty value counts as
# unset. With none set, the app runs read-only from the public RPC endpoints.
# Never put a secret in a NEXT_PUBLIC_* variable: those are built into the
# browser bundle.

# --- App ---------------------------------------------------------------------
# Canonical origin. Also the base of every file URL (<origin>/r/...), which
# is pinned on chain in EGOV1 records: set the production domain before any
# real proposal is filed. On Vercel's production deployment, drafts, edits,
# uploads and avatars are refused while it points at localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Network the app opens on: canary-relay (testnet) or enjin-relay (mainnet).
NEXT_PUBLIC_DEFAULT_NETWORK=canary-relay

# --- Wallet ------------------------------------------------------------------
# Project ID from https://cloud.reown.com. Enables Enjin Wallet and
# WalletConnect; browser-extension wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# NEXT_PUBLIC_WALLETCONNECT_RELAY_URL=wss://relay.walletconnect.com

# --- Database (Neon Postgres) ------------------------------------------------
# Pooled connection string (host contains -pooler). Enables sign-in,
# profiles, comments, drafts, moderation and security reports.
DATABASE_URL=
# Unpooled connection string. Used only by `pnpm db:migrate`.
DATABASE_URL_UNPOOLED=

# --- Storage (Cloudflare R2) -------------------------------------------------
# Storage works only when ACCOUNT_ID, ACCESS_KEY_ID, SECRET_ACCESS_KEY,
# ENDPOINT and PUBLIC_URL are all set.
R2_ACCOUNT_ID=
# API token with Object Read & Write on this bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=enjin-governance
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# The bucket's own public URL (r2.dev or a custom domain), or any https://
# placeholder if public access is off. Files are served through /r.
R2_PUBLIC_URL=

# --- Rate limits (Upstash Redis REST, recommended in production) -----------
# Shared store, so limits hold across serverless instances. Unset: each
# instance counts on its own. UPSTASH_REDIS_REST_URL and
# UPSTASH_REDIS_REST_TOKEN are accepted instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Moderation --------------------------------------------------------------
# Wallets that are always admins: SS58 addresses (any network) or 0x public
# keys, separated by commas or spaces. Admins grant further roles in
# /moderation -> Roles. Needs migrations 011 to 013.
GOVERNANCE_ADMIN_PUBLIC_KEYS=

# --- Automatic content checks (optional) ------------------------------------
# Anthropic API key, used only on the server. The key alone checks nothing:
# an admin switches the checks on and picks the model, what is checked and
# a daily limit in /moderation -> Settings. Needs migration 012.
ANTHROPIC_API_KEY=

# --- Telegram notices (optional) ---------------------------------------------
# Bot token from @BotFather. Add the bot to each chat first.
TELEGRAM_BOT_TOKEN=
# Chat for new /security reports (text and contact are posted). Reports are
# always stored in the database as well.
TELEGRAM_CHAT_ID=
# Chat for new moderation reports (a short notice, never the content) and
# content-check alerts. Unset: TELEGRAM_CHAT_ID. OFF: no moderation notices.
TELEGRAM_MODERATION_CHAT_ID=

# --- Legal pages and footer --------------------------------------------------
# Built at deploy time: redeploy after a change. The defaults (in lib/env.ts)
# name the original maintainer, so set your own details.
# Name defaults to NEXT_PUBLIC_SITE_MAINTAINER.
LEGAL_OPERATOR_NAME=
# Optional. Lines separated by "|", e.g. "Street 1 | 12345 City | Country".
# Unset: the pages say the address is available on request by email.
LEGAL_OPERATOR_ADDRESS=
# Contact address, also used for content reports and complaints.
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_PHONE=
LEGAL_VAT_ID=
# Your name (the publisher in search results), and the public source
# repository (the AGPL source offer linked in the footer).
NEXT_PUBLIC_SITE_MAINTAINER=
NEXT_PUBLIC_SOURCE_URL=

# --- Site password gate (staging) --------------------------------------------
# ON sends every visitor without the access cookie to /unlock, including API
# and /r file requests. Turn it off before real proposals are filed.
SITE_PASSWORD_STATUS=OFF
SITE_PASSWORD=

# --- Subscan (optional) ------------------------------------------------------
# Key from https://pro.subscan.io. Only decodes call data for very old
# finalised referenda; works without a key at lower rate limits.
SUBSCAN_API_KEY=

# --- RPC endpoints and explorer links (defaults shown) -----------------------
# NEXT_PUBLIC_ENJIN_RELAY_WSS=wss://rpc.relay.blockchain.enjin.io
# NEXT_PUBLIC_ENJIN_RELAY_FALLBACK_WSS=wss://enjin-relay-rpc.n.dwellir.com
# NEXT_PUBLIC_ENJIN_MATRIX_WSS=wss://rpc.matrix.blockchain.enjin.io
# NEXT_PUBLIC_ENJIN_MATRIX_FALLBACK_WSS=wss://enjin-matrix-rpc.n.dwellir.com
# NEXT_PUBLIC_CANARY_RELAY_WSS=wss://rpc.relay.canary.enjin.io
# NEXT_PUBLIC_CANARY_MATRIX_WSS=wss://rpc.matrix.canary.enjin.io
# NEXT_PUBLIC_ENJIN_SUBSCAN_URL=https://enjin.subscan.io
# NEXT_PUBLIC_MATRIX_SUBSCAN_URL=https://matrix.subscan.io
# NEXT_PUBLIC_CANARY_SUBSCAN_URL=https://canary.subscan.io
# NEXT_PUBLIC_CANARY_MATRIX_SUBSCAN_URL=https://canary-matrix.subscan.io

# --- Tooling -----------------------------------------------------------------
# true skips the checks in lib/env.ts (`pnpm lint` does this on its own).
# Never set it in production.
# SKIP_ENV_VALIDATION=true
