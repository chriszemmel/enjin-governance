# Copy to .env.local and fill in. lib/env.ts is the source of truth.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_NETWORK=canary-relay

# --- Wallet ------------------------------------------------------------------
# 32-char hex from https://cloud.reown.com - required for WC / Enjin Wallet
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Neon Postgres -----------------------------------------------------------
# Pooled URL (pgbouncer) - used for the app's read/write queries
DATABASE_URL=
# Unpooled URL - used for DDL / migrations only
DATABASE_URL_UNPOOLED=

# --- Cloudflare R2 (bucket: enjin-governance) --------------------------------
# Endpoint: https://<account-id>.r2.cloudflarestorage.com
# Public URL: the R2 dev URL or your custom domain serving the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=enjin-governance
R2_ENDPOINT=
R2_PUBLIC_URL=

# --- Subscan (enrichment fallback only) --------------------------------------
SUBSCAN_API_KEY=

# Optional override for the per-chain Subscan deep-link base URLs.
# NEXT_PUBLIC_ENJIN_SUBSCAN_URL=https://enjin.subscan.io
# NEXT_PUBLIC_MATRIX_SUBSCAN_URL=https://matrix.subscan.io
# NEXT_PUBLIC_CANARY_SUBSCAN_URL=https://canary.subscan.io
# NEXT_PUBLIC_CANARY_MATRIX_SUBSCAN_URL=https://canary-matrix.subscan.io

# --- Site password gate (set both to ON to enable) ---------------------------
SITE_PASSWORD_STATUS=OFF
SITE_PASSWORD=

# --- Security disclosures (optional Telegram fan-out) ------------------------
# Reports always persist to the DB. Set BOTH to also push each new disclosure
# to a Telegram chat (e.g. a shared Enjin team group):
#   TELEGRAM_BOT_TOKEN - from @BotFather
#   TELEGRAM_CHAT_ID    - the group/chat id (add the bot to the group first)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
