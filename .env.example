# Copy to .env.local and fill in. lib/env.ts is the source of truth.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_NETWORK=canary-relay

# --- Wallet ------------------------------------------------------------------
# 32-char hex from https://cloud.reown.com - required for WC / Enjin Wallet
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Neon Postgres -----------------------------------------------------------
# Pooled URL (pgbouncer) - used for the app's read/write queries
DATABASE_URL=
# Unpooled URL - used for DDL / migrations only
DATABASE_URL_UNPOOLED=

# --- Cloudflare R2 (bucket: enjin-governance) --------------------------------
# Endpoint: https://<account-id>.r2.cloudflarestorage.com
# Public URL: the R2 dev URL or your custom domain serving the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=enjin-governance
R2_ENDPOINT=
R2_PUBLIC_URL=

# --- Subscan (enrichment fallback only) --------------------------------------
SUBSCAN_API_KEY=

# Optional override for the per-chain Subscan deep-link base URLs.
# NEXT_PUBLIC_ENJIN_SUBSCAN_URL=https://enjin.subscan.io
# NEXT_PUBLIC_MATRIX_SUBSCAN_URL=https://matrix.subscan.io
# NEXT_PUBLIC_CANARY_SUBSCAN_URL=https://canary.subscan.io
# NEXT_PUBLIC_CANARY_MATRIX_SUBSCAN_URL=https://canary-matrix.subscan.io

# --- Legal pages (Imprint / Privacy / Terms) ---------------------------------
# Name defaults to NEXT_PUBLIC_SITE_MAINTAINER, email to chris@zyric.de.
# Without an address the pages say "postal address on request by email".
# Address lines separated by "|".
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_PHONE=
LEGAL_VAT_ID=
# Footer: maintainer name and the public source link (AGPL-3.0).
NEXT_PUBLIC_SITE_MAINTAINER=Chris Zemmel
NEXT_PUBLIC_SOURCE_URL=https://github.com/chriszemmel/enjin-governance

# --- Moderation --------------------------------------------------------------
# Wallets that are always admins (comma separated, SS58 on any network or 0x
# public keys). Admins grant moderator/admin roles from /moderation.
# Needs migration scripts/011_moderation.sql.
GOVERNANCE_ADMIN_PUBLIC_KEYS=

# --- Automatic content checks (optional) ------------------------------------
# With an Anthropic API key, admins can switch checks on and choose the model
# (Haiku 4.5 by default), what is checked and a daily limit at
# /moderation -> Settings. Needs migration scripts/012_moderation_settings.sql.
# Uploads: clear violations rejected, borderline ones blurred and queued.
# Proposal text and comments are only flagged for moderators.
ANTHROPIC_API_KEY=

# --- Site password gate (set both to ON to enable) ---------------------------
SITE_PASSWORD_STATUS=OFF
SITE_PASSWORD=

# --- Security disclosures (optional Telegram fan-out) ------------------------
# Reports always persist to the DB. Set BOTH to also push each new disclosure
# to a Telegram chat (e.g. a shared Enjin team group):
#   TELEGRAM_BOT_TOKEN - from @BotFather
#   TELEGRAM_CHAT_ID    - the group/chat id (add the bot to the group first)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
